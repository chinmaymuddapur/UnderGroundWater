# ─── Smart Aquifer Sentinel — Frontend Environment Variables ──────────────────
#
# Copy this file to .env.local for local development.
# In production (Netlify), set these in the Netlify dashboard under
# Site settings → Environment variables.
#
# NEVER commit .env or .env.local to version control.

# URL of the deployed backend API.
# Development (using Vite proxy): leave empty or use relative path — the
#   vite.config.ts proxy will forward /api/* to localhost:3001 automatically.
# Production (Netlify + hosted backend): set to your full backend URL, e.g.:
#   https://aquifer-sentinel-api.onrender.com
VITE_API_BASE_URL=

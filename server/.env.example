# ─── Smart Aquifer Sentinel — Backend Environment Variables ───────────────────
#
# Copy this file to .env for local production testing, OR set these variables
# in your hosting provider's dashboard (Render, Railway, Fly.io, etc.).
#
# NEVER commit .env to version control.

# Port to listen on. Render/Railway inject PORT automatically; this is a fallback.
PORT=3001

# Allowed CORS origin — set to your Netlify site URL in production.
# Multiple origins: comma-separated, e.g. "https://your-app.netlify.app,http://localhost:5173"
# Development fallback: http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Device authentication token — the ESP32 must send this in the
# X-Device-Token header on every POST /api/telemetry request.
# Generate a strong random value: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this secret. Do NOT put it in frontend code or the ESP32 sketch comment headers.
DEVICE_AUTH_TOKEN=change-me-to-a-long-random-secret

# SQLite database file path. Use an absolute path on persistent-disk hosting.
# Render: mount a disk at /data and set DB_PATH=/data/telemetry.db
# Local: leave as default (creates telemetry.db in the server/ directory)
DB_PATH=./telemetry.db

# How many seconds without a reading before device is considered disconnected
STALE_THRESHOLD_SECONDS=15

# Maximum readings to return from the history endpoint
MAX_HISTORY_ROWS=300

// ─────────────────────────────────────────────────────────────────────────────
// secrets.h.example
//
// SETUP INSTRUCTIONS:
//   1. Copy this file to secrets.h  (same folder as AquiferSentinel.ino)
//   2. Fill in Option A (HTTPS / production) OR Option B (HTTP / local)
//   3. secrets.h is listed in .gitignore — it will never be committed
// ─────────────────────────────────────────────────────────────────────────────

// ── Wi-Fi ────────────────────────────────────────────────────────────────────
#define WIFI_SSID "your-2.4GHz-wifi-name"
#define WIFI_PASS "your-wifi-password"

// ── Device auth token ────────────────────────────────────────────────────────
// Must match DEVICE_AUTH_TOKEN set on the backend (server env var or .env file)
// For local use, pick any string you like — e.g. "aquifer-local-2026"
#define API_AUTH_TOKEN "aquifer-local-2026"

// ─────────────────────────────────────────────────────────────────────────────
// OPTION A — HTTPS (Render / production)
//   Set USE_HTTPS 1, fill API_HOST with just the hostname (no https://)
//   Leave API_PORT as 443
// ─────────────────────────────────────────────────────────────────────────────
// #define USE_HTTPS  1
// #define API_HOST   "aquifer-sentinel-api.onrender.com"
// #define API_PORT   443

// ─────────────────────────────────────────────────────────────────────────────
// OPTION B — HTTP (local laptop, same Wi-Fi or phone hotspot)
//   Set USE_HTTPS 0, fill API_HOST with your laptop's IPv4 address
//   Run `ipconfig` on Windows, find the IPv4 under your Wi-Fi adapter
//   If the address changes, update this file and re-upload
// ─────────────────────────────────────────────────────────────────────────────
#define USE_HTTPS  0
#define API_HOST   "192.168.1.42"   // <-- replace with your actual laptop IP
#define API_PORT   3001
